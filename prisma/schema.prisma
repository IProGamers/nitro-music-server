generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model History {
  id        Int      @id @default(autoincrement())
  songId    String   @unique
  name      String
  artist    String
  image     String
  audioUrl  String
  playedAt  DateTime @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  songId    String   @unique
  name      String
  artist    String
  image     String
  audioUrl  String
  addedAt   DateTime @default(now())
}

model UserProfile {
  id        Int      @id @default(1)
  name      String   @default("Guest User")
  bio       String   @default("Music enthusiast & audiophile. Exploring the universe of sound one track at a time.")
  image     String?
  tier      String   @default("NITRO_CORE")
  isAdmin   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
