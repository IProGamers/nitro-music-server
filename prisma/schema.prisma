generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model History {
  id        Int      @id @default(autoincrement())
  songId    String
  name      String
  artist    String
  image     String
  audioUrl  String
  playedAt  DateTime @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  songId    String   @unique
  name      String
  artist    String
  image     String
  audioUrl  String
  addedAt   DateTime @default(now())
}

model UserProfile {
  id        Int      @id @default(1)
  name      String   @default("Guest User")
  bio       String   @default("Music enthusiast & audiophile. Exploring the universe of sound one track at a time.")
  image     String?
  tier      String   @default("NITRO_CORE")
  isAdmin   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
